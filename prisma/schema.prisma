enum PaymentProviderType {
  PAYSTACK
  FLUTTERWAVE
  STRIPE
  MOCK
  MANUAL
}

// Extended (protected-payment audit): PENDING/SUCCESSFUL/FAILED/REVERSED
// already existed and are unchanged; the rest is additive so no existing
// row's status value is invalidated. Deliberately no "SECURED" value —
// research against Paystack's and Flutterwave's current docs confirmed
// neither supports holding/delaying settlement, so a status implying
// custody would be a false claim (see PLATFORM_INTEGRITY.md-equivalent
// reasoning documented in lib/payment-architecture.ts).
enum PaymentStatus {
  PENDING
  INITIALIZED
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  AMOUNT_MISMATCH
  REFUND_PENDING
  PARTIALLY_REFUNDED
  FULLY_REFUNDED
  DISPUTED
  REVERSED
}

enum GatewayConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum RefundType {
  FULL
  PARTIAL
}

enum RefundStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

// TRANSFER/PAYOUT/CHARGEBACK/DISPUTE_CREATED are additive for forward
// compatibility — a business's own connected gateway CAN emit chargeback
// webhooks today (that's a real, documented Paystack/Flutterwave event),
// so these are logged if received even though nothing yet automatically
// acts on TRANSFER/PAYOUT (no platform-level transfer integration exists
// — see lib/payment-architecture.ts).
enum WebhookEventType {
  PAYMENT_SUCCESSFUL
  PAYMENT_FAILED
  PAYMENT_PENDING
  PAYMENT_REVERSED
  REFUND_SUCCESSFUL
  REFUND_FAILED
  TRANSFER_SUCCESSFUL
  TRANSFER_FAILED
  CHARGEBACK
  DISPUTE_CREATED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

// MANUAL means the business enters tracking info themselves (or staff calls
// the courier directly) — no real courier API involved. MOCK is a dev/demo
// provider mirroring PaymentProviderType.MOCK, so the fulfillment flow can be
// exercised end-to-end without live courier credentials. Neither Fashion360
// nor this codebase has real courier API access configured yet, so — per
// the Phase 7 spec's own "integrate only one suitable provider if credentials
// are available" instruction — no named real courier is wired; the
// abstraction layer (LogisticsProvider interface) is what makes adding one
// later a new adapter, not a schema change.
enum LogisticsProviderType {
  MOCK
  MANUAL
}

