// WAITING_FOR_CUSTOMER/WAITING_FOR_DESIGNER/ESCALATED added (Admin Phase 9)
// — real states the existing dispute flow had no way to represent: an
// admin who has requested more information from one side, or raised
// priority on a stuck case, previously had nothing but UNDER_REVIEW to
// leave it in regardless of who the ball was actually in. Additive only;
// RESOLVED/CLOSED still the two terminal states.
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  WAITING_FOR_CUSTOMER
  WAITING_FOR_DESIGNER
  ESCALATED
  RESOLVED
  CLOSED
}

// Mirrors OrderPriority's exact 3-value shape (no LOW tier there either) —
// same convention, applied to disputes for the first time in Admin Phase 9.
enum DisputePriority {
  NORMAL
  HIGH
  URGENT
}

enum DisputeIssueType {
  WRONG_ITEM
  DAMAGED
  POOR_QUALITY
  NOT_AS_DESCRIBED
  SIZE_MISMATCH
  LATE_DELIVERY
  MISSING_ITEMS
  // Two additions for the manual-verification delivery flow's "Did you
  // receive your order?" -> No path — PACKAGE_MISSING and NEVER_DELIVERED
  // read as near-synonyms but are kept as distinct, real values (not
  // collapsed into one) since a customer choosing between them is choosing
  // between two different labels shown in the same picker; giving both a
  // real backing value is more honest than making one silently alias the
  // other.
  PACKAGE_MISSING
  NEVER_DELIVERED
  OTHER
}

enum DisputeResolutionType {
  RELEASE_FULL_PAYMENT
  PARTIAL_REFUND
  FULL_REFUND
  REWORK_REQUIRED
  RETURN_REQUIRED
  CANCEL_ORDER
}

// PENDING/REVERSED added (protected-payment audit) — additive only.
// NOT_ELIGIBLE maps to the spec's PAYOUT_NOT_READY, PAID maps to
// PAYOUT_SUCCESSFUL (kept as-is rather than renamed, to avoid a breaking
// migration across already-shipped Phase 7 code).
// ON_HOLD added (Admin Phase 7: Payment & Escrow Management) — a genuinely
// new state the existing payout flow had no way to represent: an admin
// pausing an otherwise-eligible payout for investigation without either
// paying it (ELIGIBLE) or declaring it failed (FAILED). Only reachable from
// ELIGIBLE and only returns to ELIGIBLE or FAILED — see lib/admin-payments.ts.
enum PayoutStatus {
  NOT_ELIGIBLE
  PENDING
  ELIGIBLE
  ON_HOLD
  PROCESSING
  PAID
  FAILED
  REVERSED
}

