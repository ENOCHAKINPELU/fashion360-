// Fashion360 — Phase 1 (platform foundation) Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===================== ENUMS =====================

enum UserRole {
  SUPER_ADMIN
  OWNER
  STAFF
  CUSTOMER
}

// Scaffolded now so a future Staff-management UI doesn't require a migration.
enum StaffPermission {
  MANAGE_CUSTOMERS
  MANAGE_ORDERS
  MANAGE_APPOINTMENTS
  MANAGE_PAYMENTS
  MANAGE_SETTINGS
}

enum BusinessType {
  INDEPENDENT_DESIGNER
  TAILORING_SHOP
  FASHION_HOUSE
  CLOTHING_BRAND
  STUDIO
  OTHER
}

enum MeasurementUnit {
  METRIC
  IMPERIAL
}

enum SubscriptionPlan {
  STARTER
  GROWTH
  PRO
}

// ===================== PLATFORM / TENANCY =====================

model Business {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  logoUrl      String?
  email        String?
  phone        String?
  country      String?
  state        String?
  city         String?
  address      String?
  businessType BusinessType @default(OTHER)

  currency        String          @default("NGN")
  timezone        String          @default("Africa/Lagos")
  measurementUnit MeasurementUnit @default(METRIC)
  brandColors     Json?
  workingHours    Json?
  socialLinks     Json?

  subscriptionPlan      SubscriptionPlan @default(STARTER)
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  notifications Notification[]

  @@index([slug])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?

  // `name` is kept in sync with firstName/lastName and is what Auth.js/OAuth
  // providers read and write by default.
  name      String?
  firstName String?
  lastName  String?
  phone     String?
  position  String?
  image     String?

  role             UserRole          @default(CUSTOMER)
  staffPermissions StaffPermission[]

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])

  notificationPreferences Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  notifications Notification[]

  @@index([businessId])
}

// ===================== AUTH.JS REQUIRED MODELS =====================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Reused for both email-verification and password-reset tokens: the
// `identifier` is the user's email for verification, or `reset:<email>` for
// a password-reset request.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===================== IN-APP NOTIFICATIONS (bell + dashboard feed) =====================

model Notification {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  title  String
  body   String
  type   String    @default("info") // info | success | warning | danger — drives bell icon styling
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([businessId, userId])
}
