# Database
# Use a pooled PostgreSQL URL for DATABASE_URL. DIRECT_URL is optional, but
# recommended for Prisma schema migrations and must use a direct connection.
DATABASE_URL="postgresql://fashion360:fashion360@localhost:5432/fashion360"
DIRECT_URL="postgresql://fashion360:fashion360@localhost:5432/fashion360"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Google OAuth (Auth.js)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# File storage (Supabase)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Payments — Phase 8. Each business connects its own gateway from
# Dashboard > Payments > Payment Gateway; these platform-level keys are only
# ever used by the seed data's demo MOCK connection. Real per-business
# credentials are stored encrypted in PaymentGatewayConnection, never here.
PAYMENT_PROVIDER="mock"
ENCRYPTION_KEY="replace-with-a-long-random-string"
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
STRIPE_SECRET_KEY=""

# Email (mock/console provider by default in dev)
EMAIL_FROM="Fashion360 <no-reply@fashion360.app>"
RESEND_API_KEY=""
